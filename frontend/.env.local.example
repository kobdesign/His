# คัดลอกเป็น .env.local แล้วแก้ค่าให้ตรงกับ environment ของคุณ

# URL ของ Frappe site (ใช้ทั้งฝั่ง server และเป็นปลายทางของ rewrite /frappe-api)
FRAPPE_URL=http://localhost:8000

# API token สำหรับ server-side fetch (dev เท่านั้น)
# สร้างจาก Frappe: User -> API Access -> Generate Keys
FRAPPE_API_KEY=
FRAPPE_API_SECRET=
